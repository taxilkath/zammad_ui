<style>
*, *::before, *::after {
  box-sizing: border-box;
}
body,
html,
#loading-app,
#app[data-loaded="true"] {
  height: 100%;
}
html {
  background-color: var(--background-primary, #0F1729);
}
body,
html {
  margin: 0;
  padding: 0;
  font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 16px;
  line-height: 21px;
  -webkit-font-smoothing: antialiased;
}
#loading-app {
  position: fixed;
  inset: 0;
  background: #0F1729;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
  font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  overflow: hidden;
  transition: opacity 0.5s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.5s;
  will-change: opacity;
}
.student-logo-card {
  position: relative;
  z-index: 1;
  width: 160px;
  height: 160px;
  min-width: 160px;
  min-height: 160px;
  box-sizing: border-box;
  background: linear-gradient(145deg, #ffffff 0%, #f0f7ff 60%, #e8f2ff 100%);
  border-radius: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 22px;
  box-shadow:
    0 25px 60px rgba(0, 0, 0, 0.5),
    0 0 0 1px rgba(255, 255, 255, 0.12),
    0 0 40px rgba(59, 130, 246, 0.4),
    0 0 80px rgba(59, 130, 246, 0.18);
  animation: logoCardIn 0.5s cubic-bezier(0.16, 1, 0.3, 1) forwards, glowPulse 2.6s ease-in-out infinite 0.5s;
  will-change: transform, box-shadow, opacity;
  transform: translate3d(0, 0, 0);
  backface-visibility: hidden;
}
@keyframes logoCardIn {
  from {
    opacity: 0;
    transform: scale(0.92) translate3d(0, 0, 0);
  }
  to {
    opacity: 1;
    transform: scale(1) translate3d(0, 0, 0);
  }
}
@keyframes glowPulse {
  0%, 100% {
    box-shadow:
      0 25px 60px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.12),
      0 0 40px rgba(59, 130, 246, 0.4),
      0 0 80px rgba(59, 130, 246, 0.18);
  }
  50% {
    box-shadow:
      0 30px 70px rgba(0, 0, 0, 0.6),
      0 0 0 1px rgba(255, 255, 255, 0.2),
      0 0 65px rgba(59, 130, 246, 0.7),
      0 0 120px rgba(59, 130, 246, 0.35),
      0 0 180px rgba(59, 130, 246, 0.12);
  }
}
.student-logo-img {
  width: 100%;
  height: 100%;
  max-width: 116px;
  max-height: 116px;
  object-fit: contain;
  display: block;
  user-select: none;
  -webkit-user-drag: none;
}
.loading-sr-text {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  border: 0;
}
.loading-failed {
  position: relative;
  opacity: 0;
  color: var(--text-contrast, #ffffff);
  width: 175px;
  text-align: center;
  margin-top: -52px;
  transition: opacity 0.5s;
  font-weight: 600;
}
.loading-failed.active {
  opacity: 1;
}
.loading-dots {
  display: inline-block;
  animation: loadingDots 1.4s infinite;
}
@keyframes loadingDots {
  0%, 20% { opacity: 0; }
  40% { opacity: 0.4; }
  60% { opacity: 0.7; }
  80%, 100% { opacity: 1; }
}
</style>

<div id="loading-app">
  <!-- Background blobs matching login screen -->
  <div style="position: absolute; top: -50%; right: -25%; width: 800px; height: 800px; background: rgba(59,130,246,0.2); border-radius: 50%; filter: blur(120px); pointer-events: none;"></div>
  <div style="position: absolute; bottom: -50%; left: -25%; width: 600px; height: 600px; background: rgba(96,165,250,0.2); border-radius: 50%; filter: blur(100px); pointer-events: none;"></div>

  <!-- Logo card with rock-solid inline dimensions preventing any initial render flicker -->
  <div
    class="student-logo-card"
    style="width: 160px; height: 160px; min-width: 160px; min-height: 160px; box-sizing: border-box; background: linear-gradient(145deg, #ffffff 0%, #f0f7ff 60%, #e8f2ff 100%); border-radius: 32px; display: flex; align-items: center; justify-content: center; padding: 22px; position: relative; z-index: 1;"
  >
    <img 
      class="student-logo-img"
      src="/assets/images/branding/student_hub_logo.png"
      width="116"
      height="116"
      style="width: 100%; height: 100%; max-width: 116px; max-height: 116px; object-fit: contain; display: block;"
      alt="Student Hub"
      fetchpriority="high"
      decoding="sync"
    />
  </div>

  <div style="text-align: center; display: flex; flex-direction: column; gap: 0.35rem; margin-top: 1.5rem; position: relative; z-index: 1;">
    <span style="font-size: 0.8125rem; color: #ffffff; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; margin: 0; font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;">STUDENT HUB</span>
    <span style="font-size: 0.6875rem; color: #94a3b8; font-weight: 500; margin: 0; font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; letter-spacing: 0.05em;">Loading<span class="loading-dots">...</span></span>
  </div>

  <div class="loading-sr-text">
    <%= Translation.translate(local_assigns[:locale], 'Loading…') %>
  </div>
  <div class="loading-failed" aria-hidden="true">
    <%= Translation.translate(local_assigns[:locale], 'Loading failed, please try again later.') %>
  </div>
  <noscript>
    <div style="margin-top: 16px; color: #ffffff;">
      <%= Translation.translate(local_assigns[:locale], 'Turn on JavaScript to use Student Hub.') %>
    </div>
  </noscript>
</div>
